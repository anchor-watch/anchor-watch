{
  "name": "anchor-watch",
  "version": "0.1.0",
  "private": true,
  "description": "Trust-score aggregator, embeddable widget, and reconciliation toolkit for Stellar anchors.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^2.1.0"
  }
}
